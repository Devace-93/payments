# payments reverse proxy (local development). Single host on :8086; the
# production routing lives in the 3m4 edge Caddy (see PRODUCTION.md), with the
# same rules.

:8086 {
	# --- API ---
	handle /api/* {
		reverse_proxy api:5000
	}

	# --- Badges and the bare health check are served by the API at the host
	# root (READMEs embed /badge/<handle>.svg through GitHub's camo).
	@apiRoot path /badge/* /healthz
	handle @apiRoot {
		reverse_proxy api:5000
	}

	# --- Payments widget: a static file served by the web service, embedded by
	# the other 3m4 apps and static sites, so it must be cacheable and CORS-open.
	@widget path /pay.js
	handle @widget {
		header {
			Cache-Control "public, max-age=300"
			Access-Control-Allow-Origin "*"
			# defer: replace the upstream Cache-Control instead of adding a second one
			defer
		}
		reverse_proxy web:3000
	}

	# --- Hosted pages (Qwik SSR) --- everything else.
	handle {
		reverse_proxy web:3000
	}
}
