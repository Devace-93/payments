# ─── payments environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`. Reference: CONTRACT.md §2.

# --- Core / database ---
DATABASE_URL=postgresql+psycopg://payments:payments@postgres:5432/payments
REDIS_URL=redis://redis:6379/0
# Password of the compose postgres service (must match DATABASE_URL).
POSTGRES_PASSWORD=payments

# --- URLs ---
# Public base URL of this service (Stripe success/cancel URLs, mail links).
PAYMENTS_URL=http://localhost:8086
# accounts.3m4.net: JWT issuer + hosted login pages.
ACCOUNTS_URL=http://localhost:8085
# Where the accounts JWKS is fetched (container name over the shared `edge` network).
ACCOUNTS_INTERNAL_URL=http://accounts-api-1:5000
# Origins allowed for credentialed CORS, return_to and postMessage origins
# (comma-separated; * matches one label or any port). Each app's own origins
# (catalog.json) are checked on top of this list.
ALLOWED_ORIGINS=https://3m4.net,https://*.3m4.net,http://localhost:*,http://127.0.0.1:*
# Secret for HMACs.
SECRET_KEY=change-me-secret

# --- Stripe ---
# RESTRICTED key (rk_...): Checkout Sessions, Customers, Subscriptions, Billing
# Portal write; Products, Prices, Events, Invoices, Charges, PaymentIntents read.
# EMPTY = fake Stripe (local/CI): checkouts get a local success URL and
# `python -m dbcore.cli seed-completed <cs_id>` plays the completed event.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). With `make stripe-listen`
# the CLI prints one for the local forwarder.
STRIPE_WEBHOOK_SECRET=
# Stripe Tax on Checkout. OFF until a tax registration exists.
STRIPE_AUTOMATIC_TAX=false
# Optional Customer Portal configuration id (bpc_...); empty = the default one.
STRIPE_PORTAL_CONFIGURATION=
# Sent as integration_identifier on every Checkout Session (8 random letters suffix).
STRIPE_INTEGRATION_IDENTIFIER=3m4-payments-xxxxxxxx

# --- Money ---
# Accepted currencies (first = fallback when DEFAULT_CURRENCY is not in the list).
CURRENCIES=usd,mxn,eur
DEFAULT_CURRENCY=usd
# Minimum share of a donation that must reach Enrique after Stripe + IVA + ISR (fees.py).
MIN_NET_RATIO=0.80
# RESICO income tax applied to the gross in the fee model.
ISR_RATE=0.01
# Reference FX rates, MXN per unit (JSON). Refresh now and then.
FX_RATES_MXN={"usd":18.5,"eur":21.5,"mxn":1}
# Donation ceiling per currency, minor units (JSON).
DONATION_MAX_CENTS={"usd":50000,"mxn":1000000,"eur":50000}
# Claim codes (guest donations) expire after this many days.
CLAIM_CODE_TTL_DAYS=90

# --- Integrations ---
# Shown as a second "donate" button when set (0 % fee).
GITHUB_SPONSORS_URL=
# Phase 3: GitHub `sponsorship` webhook secret.
GITHUB_WEBHOOK_SECRET=
# Optional: enables `python -m dbcore.cli geoip-update` (GeoLite2-Country). Without
# the database GET /api/geo answers {"country": null, "currency": DEFAULT_CURRENCY}.
MAXMIND_LICENSE_KEY=
# Where the .mmdb lives inside the api container (compose mounts the `geoip` volume there).
GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# --- Outbound mail (receipts, subscription mails). Disabled => mails are logged and skipped ---
MAIL_ENABLED=false
# smtp://user:pass@host:587?starttls=1 | smtps://user:pass@host:465 | smtp://mailpit:1025 (local)
# Production (Resend): smtp://resend:re_xxx@smtp.resend.com:587?starttls=1
# (Hetzner blocks outbound 465 on new servers; 587 + STARTTLS is open and equivalent.)
SMTP_URL=
MAIL_FROM=3m4 payments <no-reply@3m4.net>

# --- PostHog (optional; no-ops if unset). Shared project; flag keys are prefixed. ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_FLAG_PREFIX=payments-
# Pin individual switches (local development and CI only; leave EMPTY in production).
# `donations` and `subscriptions` are OFF by default (gated rollout: enable them per
# user in PostHog). For local development set: FEATURE_FLAG_OVERRIDES=donations=on,subscriptions=on
FEATURE_FLAG_OVERRIDES=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute

# --- Frontend (Vite, build-time). Prefix MUST be VITE_ ---
VITE_API_URL=http://localhost:8086/api
# = PAYMENTS_URL
VITE_APP_URL=http://localhost:8086
VITE_ACCOUNTS_URL=http://localhost:8085
VITE_GITHUB_SPONSORS_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_INFO_URL=https://info.3m4.net
# metrics web analytics (https://metrics.3m4.net): the project's PUBLIC key. Empty = no tracker.
VITE_METRICS_PROJECT_KEY=
VITE_METRICS_TRACKER_URL=https://metrics.3m4.net/m.js
# retro feedback widget (https://retro.3m4.net): the project's PUBLIC key. Empty = no widget.
VITE_RETRO_PROJECT_KEY=
VITE_RETRO_WIDGET_URL=https://retro.3m4.net/widget.js
