       {"key": "pro_annual", "kind": "subscription", "entitlement": "pro", "interval": "year", "lookup_key": "retro_pro_annual", "label": "Pro (annual)", "amounts": {"usd": 5000, "mxn": 99000, "eur": 5000}}
