    {"slug": "mousetouch", "name": "MouseTouch", "origins": ["https://mouse.3m4.net", "http://localhost:*"], "products": []},
    {"slug": "retro", "name": "Retro", "origins": ["https://retro.3m4.net", "http://localhost:*"],
